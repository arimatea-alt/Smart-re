local function attackComboOnTarget(targetModel)
    while isTargetAlive(targetModel) and running do  -- TAMBAH CHECK RUNNING
        magnetToTarget(targetModel)

        heavyAttack()
        task.wait(ATK_DELAY)

        skillE()
        task.wait(ATK_DELAY)

        heavyAttack()
        task.wait(ATK_DELAY)

        basicAttack()
        task.wait(ATK_DELAY)

        skillR()
        task.wait(LOOP_DELAY)
    end
end

--=====================================================
-- MAIN LOOP (ORIGINAL + RUNNING CHECK)
--=====================================================

local function runMainLoop()
    mainLoopConnection = task.spawn(function()
        print("[AUTO SMART] START")
        StatusLabel.Text = "AUTO SMART - RUNNING"
        ToggleButton.Text = "STOP"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        while running do
            -- 1. Warp ke SmartUncle
            warpToPos(WARP_POS)
            task.wait(0.5)

            -- 2. Click NPC + start quest
            clickSmartUncle()
            task.wait(0.5)
            startQuest()
            task.wait(1)

            -- 3. Kill 3 boss berurutan
            for _, name in ipairs(TARGET_NAMES) do
                if not running then break end  -- CHECK RUNNING
                local target = nil

                -- tunggu target muncul (max 15 detik)
                local t0 = tick()
                repeat
                    target = getTargetByName(name)
                    task.wait(0.3)
                until target or tick() - t0 > 15 or not running

                if target and isTargetAlive(target) then
                    attackComboOnTarget(target)
                else
                    print("[AUTO SMART] Target tidak ditemukan / sudah mati:", name)
                end
            end

            -- 4. Balik ke SmartUncle, turn-in quest
            if running then
                warpToPos(WARP_POS)
                task.wait(0.5)
                clickSmartUncle()
                task.wait(0.5)
                finishQuest()
            end

            if running then
                print("[AUTO SMART] Satu siklus selesai, ulang...")
                task.wait(2)
            end
        end
        print("[AUTO SMART] STOPPED")
        StatusLabel.Text = "AUTO SMART - OFF"
        ToggleButton.Text = "START"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end)
end

--=====================================================
-- TOGGLE BUTTON (BARU)
--=====================================================
ToggleButton.MouseButton1Click:Connect(function()
    running = not running
    if running then
        runMainLoop()
    else
        if mainLoopConnection then
            task.cancel(mainLoopConnection)
            mainLoopConnection = nil
        end
    end
end)

