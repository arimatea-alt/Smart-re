-- FUNGSI SERANGAN (ORIGINAL 100%)
--=====================================================

local function fireHandler(argsTbl)
    local char = getCharacter()
    local handler = char:WaitForChild("PlayerHandler"):WaitForChild("HandlerEvent")
    handler:FireServer(unpack(argsTbl))
end

