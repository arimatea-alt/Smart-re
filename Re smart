-- CONFIG (ORIGINAL)
local WARP_POS = Vector3.new(797.3087158203125, 9.958056449890137, -837.666259765625)
local SmartUncleClick = workspace.NPC.SmartUncle.ClickDetector
local DialogueRemote = ReplicatedStorage.Remote.Event.Dialogue
local livesFolder = workspace:WaitForChild("Lives")
local TARGET_NAMES = {"Fyze Lv.80", "Kyza Lv.80", "Raging Steed Lv.80"}
local MAGNET_DIST = 5
local ATK_DELAY = 0.3
local LOOP_DELAY = 0.5

-- STATE
local running = false
local loopConnection

-- FUNCTIONS (ORIGINAL)
local function getCharacter()
    local char = player.Character or player.CharacterAdded:Wait()
    char:WaitForChild("HumanoidRootPart")
    char:WaitForChild("Humanoid")
    return char
end

local function warpToPos(pos)
    pcall(function()
        getCharacter().HumanoidRootPart.CFrame = CFrame.new(pos)
    end)
end

local function isTargetAlive(model)
    if not model or not model.Parent then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function getTargetByName(name)
    local model = livesFolder:FindFirstChild(name)
    return model and model:FindFirstChild("HumanoidRootPart") and model
end

local function magnetToTarget(model)
    pcall(function()
        local char = getCharacter()
        local targetRoot = model.HumanoidRootPart
        local pos = targetRoot.Position + (targetRoot.CFrame.LookVector * -MAGNET_DIST)
        char.HumanoidRootPart.CFrame = CFrame.new(pos, targetRoot.Position)
    end)
end

local function clickSmartUncle()
    pcall(fireclickdetector, SmartUncleClick)
end

local function startQuest()
    pcall(function()
        DialogueRemote:FireServer({{Choice = "Start 'Smart's Alliance'"}})
    end)
end

local function finishQuest()
    pcall(function()
        DialogueRemote:FireServer({{Choice = "Yes, I've completed it."}})
    end)
end

local function fireHandler(args)
    pcall(function()
        local char = getCharacter()
        char:WaitForChild("PlayerHandler"):WaitForChild("HandlerEvent"):FireServer(unpack(args))
    end)
end

local function heavyAttack()
    fireHandler({
        {
            CombatAction = true,
            AttackType   = "Down",
            HeavyAttack  = true,
            MouseData    = CFrame.new(952.8143310546875, 9.958056449890137, -782.230224609375, 1,0,0,0,1,0,0,0,1)
        }
    })
end

local function skillE()
    fireHandler({
        {
            Skill      = true,
            AttackType = "Down",
            Key        = "E",
            MouseData  = CFrame.new(897.6565551757812, 9.958056449890137, -819.73095703125, 1,0,0,0,1,0,0,0,1)
        }
    })
end

local function skillR()
    fireHandler({
        {
            Skill      = true,
            AttackType = "Down",
            Key        = "R",
            MouseData  = CFrame.new(864.8584594726562, 9.983565330505371, -801.572509765625, 1,0,0,0,1,0,0,0,1)
        }
    })
end

local function basicAttack()
    fireHandler({
        {
            CombatAction = true,
            LightAttack  = true,
            MouseData    = CFrame.new(835.795654296875, 9.983271598815918, -785.448974609375, 1,0,0,0,1,0,0,0,1)
        }
    })
end

local function attackCombo(target)
    while isTargetAlive(target) and running do
        magnetToTarget(target)
        heavyAttack() task.wait(ATK_DELAY)
        skillE() task.wait(ATK_DELAY)
        heavyAttack() task.wait(ATK_DELAY)
        basicAttack() task.wait(ATK_DELAY)
        skillR() task.wait(LOOP_DELAY)
    end
end

-- MAIN LOOP (ORIGINAL LOGIC)
local function mainLoop()
    loopConnection = task.spawn(function()
        while running do
            warpToPos(WARP_POS) task.wait(0.5)
            clickSmartUncle() task.wait(0.5)
            startQuest() task.wait(1)
            
            for _, name in ipairs(TARGET_NAMES) do
                if not running then break end
                local target
                local timeout = tick() + 15
                repeat
                    target = getTargetByName(name)
                    task.wait(0.3)
                until target or tick() > timeout or not running
                
                if target then attackCombo(target) end
            end
            
            if running then
                warpToPos(WARP_POS) task.wait(0.5)
                clickSmartUncle() task.wait(0.5)
                finishQuest()
                task.wait(2)
            end
        end
        status.Text = "OFF"
        status.TextColor3 = Color3.new(1, 0.5, 0)
    end)
end

-- TOGGLE
button.MouseButton1Click:Connect(function()
    running = not running
    if running then
        button.Text = "STOP"
        button.BackgroundColor3 = Color3.new(0.2, 0.8, 0.2)
        status.Text = "RUNNING"
        status.TextColor3 = Color3.new(0, 1, 0)
        mainLoop()
    else
        button.Text = "START"
        button.BackgroundColor3 = Color3.new(0.8, 0.2, 0.2)
        status.Text = "OFF"
        status.TextColor3 = Color3.new(1, 0.5, 0)
        if loopConnection then
            task.cancel(loopConnection)
            loopConnection = nil
        end
    end
end)

