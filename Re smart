--=====================================================
-- FUNGSI UTILITAS (ORIGINAL)
--=====================================================

local function getCharacter()
    local char = player.Character or player.CharacterAdded:Wait()
    char:WaitForChild("HumanoidRootPart")
    char:WaitForChild("Humanoid")
    return char
end

local function warpToPos(pos)
    local char = getCharacter()
    local hrp  = char.HumanoidRootPart
    hrp.CFrame = CFrame.new(pos)
end

local function isTargetAlive(model)
    if not model or not model.Parent then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health > 0 then
        return true
    end
    return false
end

local function getTargetByName(name)
    local model = livesFolder:FindFirstChild(name)
    if model and model:FindFirstChild("HumanoidRootPart") then
        return model
    end
    return nil
end

local function magnetToTarget(model)
    local char = getCharacter()
    local hrp  = char.HumanoidRootPart
    local targetRoot = model:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return end

    local targetPos = targetRoot.Position + (targetRoot.CFrame.LookVector * -MAGNET_DIST)
    hrp.CFrame = CFrame.new(targetPos, targetRoot.Position)
end

--=====================================================
-- FUNGSI QUEST (ORIGINAL)
--=====================================================

local function clickSmartUncle()
    pcall(function()
        fireclickdetector(SmartUncleClick)
    end)
end

local function startQuest()
    local args = {
        {
            Choice = "Start 'Smart's Alliance'"
        }
    }
    DialogueRemote:FireServer(unpack(args))
end

local function finishQuest()
    local args = {
        {
            Choice = "Yes, I've completed it."
        }
    }
    DialogueRemote:FireServer(unpack(args))
end

