-- CONFIG
local WARP_POS = Vector3.new(797.3087158203125, 9.958056449890137, -837.666259765625)
local SmartUncleClick = workspace.NPC.SmartUncle.ClickDetector
local DialogueRemote = game:GetService("ReplicatedStorage").Remote.Event.Dialogue
local livesFolder = workspace:WaitForChild("Lives")
local TARGET_NAMES = {"Fyze Lv.80", "Kyza Lv.80", "Raging Steed Lv.80"}
local MAGNET_DIST = 5
local ATK_DELAY = 0.3
local LOOP_DELAY = 0.5

-- FUNCTIONS
local function getCharacter()
    local char = player.Character or player.CharacterAdded:Wait()
    char:WaitForChild("HumanoidRootPart")
    char:WaitForChild("Humanoid")
    return char
end

local function warp(pos)
    pcall(function()
        getCharacter().HumanoidRootPart.CFrame = CFrame.new(pos)
    end)
end

local function clickNPC()
    pcall(fireclickdetector, SmartUncleClick)
end

local function dialogue(choice)
    pcall(function()
        DialogueRemote:FireServer({{Choice = choice}})
    end)
end

local function attack(key)
    pcall(function()
        local char = getCharacter()
        local handler = char.PlayerHandler.HandlerEvent
        local mouseData = CFrame.new(850, 10, -800)
        if key == "heavy" then
            handler:FireServer({{CombatAction = true, AttackType = "Down", HeavyAttack = true, MouseData = mouseData}})
        elseif key == "E" then
            handler:FireServer({{Skill = true, AttackType = "Down", Key = "E", MouseData = mouseData}})
        elseif key == "R" then
            handler:FireServer({{Skill = true, AttackType = "Down", Key = "R", MouseData = mouseData}})
        elseif key == "basic" then
            handler:FireServer({{CombatAction = true, LightAttack = true, MouseData = mouseData}})
        end
    end)
end

local function killTarget(name)
    local target
    for i = 1, 50 do
        target = livesFolder:FindFirstChild(name)
        if target and target:FindFirstChild("HumanoidRootPart") and target:FindFirstChildOfClass("Humanoid").Health > 0 then
            break
        end
        wait(0.3)
    end
    
    if target then
        while target.Parent and target:FindFirstChildOfClass("Humanoid").Health > 0 and running do
            local root = target.HumanoidRootPart
            getCharacter().HumanoidRootPart.CFrame = CFrame.new(root.Position - root.CFrame.LookVector * MAGNET_DIST, root.Position)
            
            attack("heavy") wait(ATK_DELAY)
            attack("E") wait(ATK_DELAY)
            attack("heavy") wait(ATK_DELAY)
            attack("basic") wait(ATK_DELAY)
            attack("R") wait(LOOP_DELAY)
        end
    end
end

-- MAIN LOOP
local mainLoop
local function toggle()
    running = not running
    
    if running then
        button.Text = "STOP SCRIPT"
        button.BackgroundColor3 = Color3.new(0.2, 0.8, 0.2)
        status.Text = "RUNNING..."
        status.TextColor3 = Color3.new(0, 1, 0)
        
        mainLoop = task.spawn(function()
            while running do
                warp(WARP_POS) wait(1)
                clickNPC() wait(0.5)
                dialogue("Start 'Smart's Alliance'") wait(1)
                
                for _, name in pairs(TARGET_NAMES) do
                    if not running then break end
                    killTarget(name)
                end
                
                warp(WARP_POS) wait(1)
                clickNPC() wait(0.5)
                dialogue("Yes, I've completed it.") wait(2)
            end
        end)
    else
        button.Text = "START SCRIPT"
        button.BackgroundColor3 = Color3.new(0.8, 0.2, 0.2)
        status.Text = "STOPPED"
        status.TextColor3 = Color3.new(1, 0.5, 0.5)
        if mainLoop then task.cancel(mainLoop) end
    end
end

button.MouseButton1Click:Connect(toggle)

print("🟢 FULL AUTO SMART LOADED - CLICK START!")
